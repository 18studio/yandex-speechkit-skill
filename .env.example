# Yandex SpeechKit credentials.
# Укажите один из двух способов аутентификации:
# - `YANDEX_API_KEY` для API key
# - `YANDEX_IAM_TOKEN` для IAM token
# Можно оставить оба пустыми в примере, но в локальном `.env` должен быть заполнен хотя бы один.
YANDEX_API_KEY=
YANDEX_IAM_TOKEN=

# Опционально: ID каталога в Yandex Cloud.
# Нужен не для всех сценариев, но используется как `folderId` / `x-folder-id`,
# если ваша схема авторизации или API-запрос этого требует.
YANDEX_FOLDER_ID=

# Yandex Object Storage credentials.
# Нужны для async-пайплайна `transcribe_file_async.py` и утилит загрузки/pre-sign URL.
YANDEX_STORAGE_ACCESS_KEY=
YANDEX_STORAGE_SECRET_KEY=
YANDEX_STORAGE_BUCKET=

# Опционально: endpoint Object Storage.
# Меняйте только если работаете не со стандартным endpoint.
YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net

# Опционально: регион подписи S3-запросов.
# По умолчанию используется `ru-central1`.
YANDEX_STORAGE_REGION=ru-central1

# Опционально: префикс для авто-сгенерированных object key в bucket.
# Используется `transcribe_file_async.py`.
YANDEX_SPEECHKIT_OBJECT_PREFIX=speechkit

# Опционально: формат подготовленного аудио для async-распознавания.
# Поддерживаемые значения: `ogg-opus`, `wav`, `mp3`.
YANDEX_SPEECHKIT_ASYNC_FORMAT=ogg-opus

# Опционально: sample rate подготовленного аудио в Гц.
# Используется на этапе `prepare_audio.py` перед загрузкой.
YANDEX_SPEECHKIT_SAMPLE_RATE=16000

# Опционально: количество каналов в подготовленном аудио.
# `1` = mono, обычно это лучший дефолт для распознавания речи.
YANDEX_SPEECHKIT_CHANNELS=1

# Опционально: время жизни pre-signed URL в секундах.
# Используется, если файл в Object Storage открывается через временную приватную ссылку.
YANDEX_SPEECHKIT_URL_TTL_SECONDS=86400

# Опционально: языковое ограничение для SpeechKit.
# Примеры: `ru-RU`, `en-US`.
YANDEX_SPEECHKIT_LANGUAGE_CODE=ru-RU

# Опционально: модель распознавания SpeechKit.
# Обычно достаточно `general`.
YANDEX_SPEECHKIT_MODEL=general

# Исторические короткие алиасы, которые код тоже понимает.
# Предпочтительно использовать YANDEX_* переменные выше, а эти оставлены для совместимости.
# API_KEY=
# IAM_TOKEN=
# ACCESS_KEY=
# SECRET_KEY=
